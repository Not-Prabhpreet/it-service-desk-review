	partition 'Live Tickets' = m
		mode: import
		source =
				let
				    Empty = #table(type table [Ticket = text, Category = text, Priority = text, Status = text, Urgency = text, Impact = text, AssignedTo = text, RequesterName = text, OpenedAt = datetime, SlaDueAt = datetime, WarnAt = datetime, ResolvedAt = datetime, ResolutionHours = number, MetSLA = text, WarnSent = logical, Escalated = logical], {}),
				    Source =
				        if SharePointSiteUrl = "" then Empty
				        else
				            let
				                Lists = SharePoint.Tables(SharePointSiteUrl, [Implementation = "2.0", ViewMode = "All"]),
				                Items = Lists{[Title = "IT Tickets"]}[Items],
				                Renamed = Table.RenameColumns(Items, {{"Title", "Ticket"}}),
				                Selected = Table.SelectColumns(Renamed, {"Ticket", "Category", "Priority", "Status", "Urgency", "Impact", "AssignedTo", "RequesterName", "OpenedAt", "SlaDueAt", "WarnAt", "ResolvedAt", "ResolutionHours", "MetSLA", "WarnSent", "Escalated"}, MissingField.UseNull)
				            in
				                Selected,
				    Typed = Table.TransformColumnTypes(Source, {{"Ticket", type text}, {"Category", type text}, {"Priority", type text}, {"Status", type text}, {"Urgency", type text}, {"Impact", type text}, {"AssignedTo", type text}, {"RequesterName", type text}, {"OpenedAt", type datetime}, {"SlaDueAt", type datetime}, {"WarnAt", type datetime}, {"ResolvedAt", type datetime}, {"ResolutionHours", type number}, {"MetSLA", type text}, {"WarnSent", type logical}, {"Escalated", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
