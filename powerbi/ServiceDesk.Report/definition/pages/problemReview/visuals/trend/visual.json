{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.6.0/schema.json",
  "name": "trend",
  "position": {
    "x": 24,
    "y": 192,
    "z": 11000,
    "height": 260,
    "width": 610,
    "tabOrder": 11000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "week_start"
                }
              },
              "queryRef": "Date.week_start",
              "nativeQueryRef": "week_start",
              "displayName": "Week starting"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Measures"
                    }
                  },
                  "Property": "Breach Rate"
                }
              },
              "queryRef": "Measures.Breach Rate",
              "nativeQueryRef": "Breach Rate",
              "displayName": "Category 46 breach rate"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Measures"
                    }
                  },
                  "Property": "Desk Breach Rate"
                }
              },
              "queryRef": "Measures.Desk Breach Rate",
              "nativeQueryRef": "Desk Breach Rate",
              "displayName": "Whole desk breach rate"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "dataPoint": [
        {
          "selector": {
            "metadata": "Measures.Breach Rate"
          },
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#eb6834'"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "selector": {
            "metadata": "Measures.Desk Breach Rate"
          },
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#b4b2ab'"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "start": {
              "expr": {
                "Literal": {
                  "Value": "0.0D"
                }
              }
            },
            "end": {
              "expr": {
                "Literal": {
                  "Value": "1.0D"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Trend: Category 46 breach rate vs whole desk, by week opened'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "11.0D"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#0b0b0b'"
                    }
                  }
                }
              }
            },
            "bold": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}
